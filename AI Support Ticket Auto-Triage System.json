        "responses": {
          "values": [
            {
              "content": "=You are an expert customer support ticket triage assistant.\n\nAnalyze the support ticket below.\n\nTicket ID: {{ $json.ticket_id }}\nCustomer Name: {{ $json.customer_name }}\nCustomer Type: {{ $json.customer_type }}\nSubject: {{ $json.subject }}\nMessage: {{ $json.message }}\nProduct: {{ $json.product }}\nPayment Amount: {{ $json.payment_amount }}\nPayment Status: {{ $json.payment_status }}\nAccount Status: {{ $json.account_status }}\nPrevious Tickets: {{ $json.previous_tickets }}\nChannel: {{ $json.channel }}\n\nDetermine:\n\n1. Ticket category\n2. Priority\n3. Responsible department\n4. Sentiment\n5. Short summary\n6. Main issue\n7. Recommended action\n8. Professional response to the customer\n\nPriority rules:\n\nHigh = payment problems, account access problems, service outage, security concerns, or issues seriously affecting the customer.\n\nMedium = important issue but customer can continue using the service.\n\nLow = general questions, feedback, or minor issues.\n\nReturn EXACTLY:\n\nCategory: [category]\nPriority: [High/Medium/Low]\nDepartment: [department]\nSentiment: [Positive/Neutral/Negative]\nSummary: [short summary]\nMain Issue: [main issue]\nRecommended Action: [action]\nCustomer Reply: [professional response]"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
